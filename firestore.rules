rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if false;

      match /progress/{difficulty} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /difficultyOrders/{difficulty} {
        allow read, write: if false;
      }

      // Fichas de salas: el jugador ve su saldo; solo game-progress lo cambia.
      match /fichas/{documento} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Salas terminadas del jugador; las escribe game-progress al cerrarlas.
      match /historialSalas/{codigo} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /games/{gameId} {
      allow read, write: if false;

      match /purchases/{instrumentId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/games/$(gameId))
            .data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    // Salas de "Desafía a tus amigos": solo la función game-progress escribe.
    // Un jugador solo lee la sala donde ya está (tiempo real). No se pueden
    // listar: las salas públicas las ofrece la acción listarSalasPublicas
    // (vista reducida) y se entra por código con unirseSala.
    match /salas/{codigo} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.jugadores;
      allow list: if false;
      allow write: if false;
    }

    // Catálogo por género ({genero}_songs, _levels, _privateLevelAnswers,
    // _intros: vallenato, reggaeton, rock_pop, salsa, popular) y todo lo
    // demás: solo el servidor, con la cuenta de servicio.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
