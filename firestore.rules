rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if false;

      match /progress/{difficulty} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /difficultyOrders/{difficulty} {
        allow read, write: if false;
      }
    }

    match /songs/{songId} {
      allow read, write: if false;
    }

    match /levels/{levelId} {
      allow read, write: if false;

      match /fragments/{fragmentId} {
        allow read, write: if false;
      }
    }

    match /games/{gameId} {
      allow read, write: if false;

      match /purchases/{instrumentId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/games/$(gameId))
            .data.uid == request.auth.uid;
        allow write: if false;
      }
    }

    // Salas de "Desafía a tus amigos": solo la función game-progress escribe.
    // Los jugadores leen su sala en tiempo real; las públicas en espera se
    // pueden listar para unirse (la consulta debe filtrar por publica y estado).
    match /salas/{codigo} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.jugadores;
      allow list: if request.auth != null
        && resource.data.publica == true
        && resource.data.estado == 'esperando';
      allow write: if false;
    }

    match /privateLevelAnswers/{levelId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
